{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx", "module": "ESNext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "skipLibCheck": true,
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "baseUrl": ".", "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client", "vite-plugin-svgr/client"]
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
